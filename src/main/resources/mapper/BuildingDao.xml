<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace=绑定一个对应的Dao/Mapper接口-->
<mapper namespace="com.cafuc.icfb.DAO.BuildingDao">
    <!--select查询语句-->
    <select id="getBuildingListAll" resultType="com.cafuc.icfb.entity.Building">
        select * from building;
    </select>
    <select id="getBuildingList" resultType="com.cafuc.icfb.entity.Building">
        SELECT * FROM building
        LIMIT #{pagesize} OFFSET #{offset};
    </select>
    <insert id="addBuilding" parameterType="String">
        INSERT INTO building (build_name, introduction)
        VALUES (#{buildname}, #{introduction});
    </insert>
</mapper>